pipeline{
    agent any

    stages{

        stage('Checkout'){
            steps{
                echo 'cloning...'
                checkout scm
            }
        }
        stage('Install'){
            steps{
                echo 'Installing dependencies..'
                sh 'npm ci'
            }

        }
        stage('Test'){
            steps{
                sh 'npm test'
            }

        }
        stage('Build image'){
            steps{
                sh 'docker build -t myapp:latest .'
            }

        }
        stage('Registry login & push'){

            withCredentials([
                usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_TOKEN'
                )
            ]){
            sh '''
                set +x
                echo "$DOCKER_TOKEN" | docker login \
                    --username "$DOCKER_USER" \
                    --password-stdin
            '''
            sh "docker push myapp:latest"
        }

        }
        stage('Remote deployment'){
            steps{
                sshagent(credentials: ['deploy-ssh-key']){
                    sh '''
                set -eu

                ssh ubuntuserver@192.168.1.7 '
                set -eu
                docker pull zaidkhann/myapp:latest
                docker stop myapp 2>/dev/null || true
                docker rm myapp 2>/dev/null || true

                docker run -d \
                        --name myapp \
                        --restart unless-stopped \
                        -p 3000:3000 \
                        zaidkhann/myapp:latest

                    docker ps --filter name=myapp
                '
                '''
                }
            }

        }
    }
    post{
        success {
            emailext (
                subject: "SUCCESS: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]'",
                body: "The build passed. Check console output at ${env.BUILD_URL}",
                to: 'mkzaid46@gmail.com'
            )
        }
        failure {
            emailext (
                subject: "FAILURE: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]'",
                body: "The build failed. Check console output at ${env.BUILD_URL}",
                to: 'mkzaid46@gmail.com'
            )
        }
    }
}
